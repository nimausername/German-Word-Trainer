{
  "name": "german-word-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js spaced-repetition trainer for about 4000 high-frequency German words with Persian glosses. App only: connect your own Keycloak and PostgreSQL.",
  "license": "MIT",
  "author": "Nima Khabbazi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimausername/German-Word-Trainer.git"
  },
  "bugs": {
    "url": "https://github.com/nimausername/German-Word-Trainer/issues"
  },
  "homepage": "https://github.com/nimausername/German-Word-Trainer#readme",
  "keywords": [
    "german",
    "persian",
    "farsi",
    "spaced-repetition",
    "sm2",
    "language-learning",
    "nextjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed-words.ts",
    "db:build-words": "python3 scripts/build-words-4000.py",
    "db:seed:full": "tsx scripts/seed-words-full.ts",
    "verify:keycloak": "tsx scripts/verify-keycloak.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@swc/helpers": "0.5.23",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2"
}
