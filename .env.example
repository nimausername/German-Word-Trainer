# Keycloak (your identity server — not part of this repo)
KEYCLOAK_ISSUER=https://auth.example.com/realms/germanword
KEYCLOAK_CLIENT_ID=german-word-web
KEYCLOAK_CLIENT_SECRET=

# PostgreSQL (your database — not part of this repo)
DATABASE_URL=postgresql://user:password@db.example.com:5432/germanword

# Auth.js
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=

# Server
PORT=3000
NODE_ENV=development

# Learning defaults
NEW_WORDS_PER_DAY_DEFAULT=20

# Logging (optional)
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# ReUI (optional — only needed for premium blocks / Motion Icons)
# REUI_LICENSE_KEY=
